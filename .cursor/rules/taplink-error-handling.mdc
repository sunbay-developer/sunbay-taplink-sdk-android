## Complete Error Handling Pattern

```kotlin
client.sale(request, object : PaymentCallback {
    override fun onSuccess(result: PaymentResult) {
        when {
            result.isSuccess()    -> showPaymentSuccess(result)
            result.isProcessing() -> queryWithPolling(result.transactionRequestId!!)
            result.isFailed()     -> showPaymentFailed(result.message)
        }
    }

    override fun onFailure(error: PaymentError) {
        Log.e("Payment", "Error ${error.code}: ${error.message} | traceId=${error.traceId}")

        when (error.category) {
            ErrorCategory.INITIALIZATION -> reinitializeSDK()
            ErrorCategory.CONNECTION     -> reconnectAndRetry()
            ErrorCategory.AUTHENTICATION -> showCredentialError(error.suggestion)
            ErrorCategory.TRANSACTION    -> handleTransactionError(error)
        }
    }

    override fun onProgress(event: PaymentEvent) { updateUI(event) }
})

private fun handleTransactionError(error: PaymentError) {
    when (error.code) {
        "306" -> queryWithPolling(error.transactionRequestId!!)
        "308" -> showError("Duplicate transaction. Create a new order.")
        else  -> {
            if (error.canRetryWithSameId) {
                showRetryDialog(error.message) { retryTransaction() }
            } else {
                showError("${error.message}\n\nSuggestion: ${error.suggestion}")
            }
        }
    }
}
```

