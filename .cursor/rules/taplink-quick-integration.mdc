# Taplink SDK – Quick Integration Recipes

Step-by-step patterns for common integration tasks.  
Each recipe is self-contained — copy into your project and adjust marked parameters.

---

## Recipe 1: Minimal Working Integration

### Step 1 — Application class

```kotlin
class MyApp : Application() {
    override fun onCreate() {
        super.onCreate()
        TaplinkSDK.init(this, TaplinkConfig(
            appId = "YOUR_APP_ID",          // ← Replace
            merchantId = "YOUR_MERCHANT_ID", // ← Replace
            secretKey = "YOUR_SECRET_KEY"    // ← Replace
        ))
    }
}
```

### Step 2 — Connect in Activity

```kotlin
class PayActivity : AppCompatActivity() {

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_pay)

        // Monitor connection status throughout lifecycle
        TaplinkSDK.setConnectionListener(object : ConnectionListener {
            override fun onConnected(deviceId: String, taproVersion: String) {
                runOnUiThread { payButton.isEnabled = true }
            }
            override fun onDisconnected(reason: String) {
                runOnUiThread { payButton.isEnabled = false }
            }
            override fun onError(error: ConnectionError) {
                runOnUiThread { showError(error.message) }
            }
        })

        // Connect — App-to-App auto-detects if Tapro is on the same device
        TaplinkSDK.connect(ConnectionConfig.createAppMode(), object : ConnectionListener {
            override fun onConnected(d: String, v: String) { /* one-shot */ }
            override fun onDisconnected(r: String) {}
            override fun onError(e: ConnectionError) { showError(e.message) }
        })
    }

    override fun onDestroy() {
        super.onDestroy()
        TaplinkSDK.removeConnectionListener()
        TaplinkSDK.disconnect()
    }
}
```

### Step 3 — Execute a sale

```kotlin
fun pay(amountCents: Long) {
    val request = SaleRequest.builder()
        .setTransactionRequestId("TXN_${System.currentTimeMillis()}")
        .setReferenceOrderId("ORD_${System.currentTimeMillis()}")
        .setAmount(AmountInfo(BigDecimal(amountCents), "USD"))
        .build()

    TaplinkSDK.getClient().sale(request, object : PaymentCallback {
        override fun onProgress(event: PaymentEvent) {
            runOnUiThread { statusText.text = event.message ?: "Processing..." }
        }
        override fun onSuccess(result: PaymentResult) {
            runOnUiThread {
                if (result.isSuccess()) showSuccess(result)
                else if (result.isProcessing()) queryStatus(result.transactionRequestId!!)
                else showFailed(result.transactionResultMsg)
            }
        }
        override fun onFailure(error: PaymentError) {
            runOnUiThread { handleError(error) }
        }
    })
}
```

