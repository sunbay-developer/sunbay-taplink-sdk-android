## Recipe 9: Batch Close (End-of-Day Settlement)

```kotlin
val request = BatchCloseRequest.builder()
    .setTransactionRequestId("TXN_${System.currentTimeMillis()}")
    .build()

TaplinkSDK.getClient().batchClose(request, object : PaymentCallback {
    override fun onSuccess(result: PaymentResult) {
        val info = result.batchCloseInfo
        showBatchSummary(
            count = info?.totalCount ?: 0,
            total = info?.totalAmount ?: BigDecimal.ZERO,
            tips = info?.totalTip ?: BigDecimal.ZERO
        )
    }
    override fun onFailure(error: PaymentError) { showError(error.message) }
    override fun onProgress(event: PaymentEvent) {}
})
```

