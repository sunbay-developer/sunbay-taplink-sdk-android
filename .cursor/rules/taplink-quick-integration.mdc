## Recipe 8: Timeout Recovery (Error 306)

```kotlin
override fun onFailure(error: PaymentError) {
    when {
        error.code == "306" -> {
            // Transaction MAY have succeeded — query before retrying
            pollStatus(error.transactionRequestId!!, attempt = 1)
        }
        error.canRetryWithSameId -> {
            // Safe to retry with same request ID
            retryTransaction()
        }
        else -> {
            // Must use a NEW transactionRequestId
            showError(error.message)
        }
    }
}

private fun pollStatus(txnRequestId: String, attempt: Int) {
    if (attempt > 12) { showUnknownStatus(txnRequestId); return }

    val query = QueryRequest().setTransactionRequestId(txnRequestId)
    TaplinkSDK.getClient().query(query, object : PaymentCallback {
        override fun onSuccess(result: PaymentResult) {
            when {
                result.isSuccess()    -> handleSuccess(result)
                result.isFailed()     -> handleFailed(result)
                result.isProcessing() -> {
                    Handler(Looper.getMainLooper()).postDelayed({
                        pollStatus(txnRequestId, attempt + 1)
                    }, 5000)
                }
            }
        }
        override fun onFailure(error: PaymentError) {
            Handler(Looper.getMainLooper()).postDelayed({
                pollStatus(txnRequestId, attempt + 1)
            }, 5000)
        }
        override fun onProgress(event: PaymentEvent) {}
    })
}
```

