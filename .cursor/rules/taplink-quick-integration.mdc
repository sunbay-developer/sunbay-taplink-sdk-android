## Recipe 6: Pre-Auth → Capture Flow (Hotels, Rentals)

```kotlin
// Step 1: Freeze funds
fun authorize(amountCents: Long) {
    val request = AuthRequest.builder()
        .setTransactionRequestId("TXN_${System.currentTimeMillis()}")
        .setReferenceOrderId("AUTH_${System.currentTimeMillis()}")
        .setAmount(AuthAmountInfo(BigDecimal(amountCents), "USD"))
        .build()
    TaplinkSDK.getClient().auth(request, paymentCallback)
}

// Step 2: Capture (complete the charge)
fun capture(originalAuthTxnId: String, finalAmountCents: Long) {
    val request = PostAuthRequest.builder()
        .setTransactionRequestId("TXN_${System.currentTimeMillis()}")
        .setOriginalTransactionId(originalAuthTxnId)
        .setAmount(AmountInfo(BigDecimal(finalAmountCents), "USD"))
        .build()
    TaplinkSDK.getClient().postAuth(request, paymentCallback)
}
```

