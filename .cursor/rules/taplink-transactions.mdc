## PaymentCallback

All transactions share the same callback:

```kotlin
val callback = object : PaymentCallback {
    override fun onProgress(event: PaymentEvent) {
        // Update UI based on transaction stage
        when (event.eventCode) {
            "PROCESSING"       -> showStatus("Processing...")
            "WAITING_CARD"     -> showStatus("Please present card")
            "CARD_DETECTED"    -> showStatus("Card detected")
            "READING_CARD"     -> showStatus("Reading card...")
            "WAITING_PIN"      -> showStatus("Enter PIN on terminal")
            "WAITING_SIGNATURE"-> showStatus("Sign on terminal")
            "WAITING_RESPONSE" -> showStatus("Waiting for gateway...")
            "PRINTING"         -> showStatus("Printing receipt...")
            "COMPLETED"        -> hideStatus()
            "CANCEL"           -> showStatus("Transaction cancelled")
        }
    }

    override fun onSuccess(result: PaymentResult) {
        // result.isSuccess() == true when code=="0" && transactionStatus=="SUCCESS"
        showSuccess(result.transactionId, result.amount)
    }

    override fun onFailure(error: PaymentError) {
        showError(error.code, error.message, error.suggestion)
    }
}
```

