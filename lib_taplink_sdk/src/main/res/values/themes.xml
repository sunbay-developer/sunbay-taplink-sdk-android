<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Fullscreen theme for the built-in QR scanner Activity.

        QrScannerActivity extends AppCompatActivity, which requires a Theme.AppCompat
        (or descendant) theme. It must NOT inherit the host app's theme (which may be a
        Compose/Material3 theme not derived from AppCompat), otherwise setContentView
        throws "You need to use a Theme.AppCompat theme (or descendant) with this activity."
    -->
    <style name="Theme.Taplink.QrScanner" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
